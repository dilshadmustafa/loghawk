
LH_DUCKDB_FILE_PATH = "data/db/my_database.duckdb"
LH_DUCKDB_TABLE_NAME = "convo"
LH_LANCEDB_FILE_PATH = "data/db/mylancedb"
LH_LANCEDB_TABLE_NAME = "loghawk"
# Valid values: ollama, bedrock, azure_ai, microsoft_foundry
LH_LLM_PROVIDER=ollama
# Existing model name; LiteLLM provider routing is handled by LogHawk.
LH_LLM_MODEL = "llama3.2:3b"
# Provider base URL. Ollama expects the server root, without /api/chat.
LH_LLM_BASE_URL=http://172.22.64.1:11434
# Leave blank for Ollama and AWS credential-chain authentication.
LH_LLM_API_KEY=
LH_LLM_TIMEOUT_SECONDS=300
# Optional comma-separated model fallback list; blank uses Ollama defaults.
LH_LLM_FALLBACK_MODELS=
# Embedding model is routed through LiteLLM. Ensure this model is available in Ollama.
LH_EMBEDDING_MODEL=ollama/nomic-embed-text
LH_EMBEDDING_BASE_URL=http://172.22.64.1:11434
LH_EMBEDDING_API_KEY=
LH_EMBEDDING_BATCH_SIZE=32

# External source files are read from these S3 URLs; outputs remain in RustFS.
LH_EXTERNAL_DATA_USE=false
# Comma-separated S3 URLs; the region list below must have the same number of entries.
# Make sure file names are unique or use timestamps in file names across all buckets and S3 locations to avoid file name clash.
# File names should be unique within Train data locations
# File names should be unique within Raw data locations
# There can be same file names across Train and Raw data locations.
LH_EXTERNAL_DATA_TRAIN=s3://external1/,s3://k8slogstrain/
LH_EXTERNAL_S3BUCKET_REGIONS_TRAIN=us-east-1,us-east-1
LH_EXTERNAL_DATA_RAW=s3://external2/,s3://k8slogs/
LH_EXTERNAL_S3BUCKET_REGIONS_RAW=us-east-1,us-east-1
# true only if the external S3 provider supports S3 Select.
LH_EXTERNAL_S3SELECT_SUPPORT=true
# Optional endpoint and credentials for one non-AWS S3-compatible source.
# Leave blank for native AWS S3 and use the AWS credential chain.
LH_EXTERNAL_S3_ENDPOINT="http://localhost:9000"
LH_EXTERNAL_S3_ACCESS_KEY_ID=rustfsadmin
LH_EXTERNAL_S3_SECRET_ACCESS_KEY=rustfsadmin

LH_S3_ENDPOINT="http://localhost:9000"
LH_S3_BUCKET="loghawk-data"
LH_S3_BATCH_FOLDER="somefolder"
LH_S3_SELECT_SUPPORTED=true
LH_S3_SELECT_RECORD_FILTER="WARN,ERROR"
LH_S3_SELECT_USE_TRAIN_PHASE=true
LH_S3_SELECT_USE_DETECT_PHASE=true
LH_S3_SELECT_SKIP_FILENAMES="metrics*,trace*,perf*,health*,status*,heartbeat*"

LH_TRAIN_PHASE=true
LH_DETECT_PHASE=true
# Number of randomly sampled rows retained per raw file.
LH_IDENTITY_MAPPING_SAMPLE_SIZE=10
# Fixed seed keeps reservoir samples repeatable for unchanged input files.
LH_IDENTITY_MAPPING_SAMPLE_SEED=42
# Valid values: reservoir, first
LH_IDENTITY_MAPPING_SAMPLE_STRATEGY=reservoir
# true skips existing mappings; false regenerates and overwrites them.
LH_IDENTITY_MAPPING_SKIP_EXISTING=false
# Default Stage C correlation window, in minutes.
LH_CORRELATION_WINDOW_MINUTES=5
# Optional comma-separated ensemble list; algorithm prefix sets backend/device.
# Valid IDs: sklearn-isolationforest, cuml-isolationforest,
# pyod-isolationforest, pyod-copod, pyod-ecod, pyod-hbos,
# pyod-knn, pyod-lof, pyod-ocsvm, pyod-pca,
# pyod-autoencoder (CPU), pyod-autoencoder-gpu (CUDA GPU)
# Leave empty to use the single-detector settings below.
LH_ANOMALY_ALGORITHMS=sklearn-isolationforest,pyod-copod
#LH_ANOMALY_ALGORITHMS=sklearn-isolationforest,pyod-autoencoder-gpu
#LH_ANOMALY_ALGORITHMS=cuml-isolationforest,pyod-autoencoder-gpu
# Ensemble threshold applied to the equal-weight mean percentile score (0, 1).
LH_ENSEMBLE_THRESHOLD=0.95

# Used only when LH_ANOMALY_ALGORITHMS is empty.
# Single-detector mode only
# Valid values: sklearn, cuml, pyod
LH_ANOMALY_BACKEND=sklearn
# Valid pairs for single-detector mode:
# sklearn + sklearn-isolationforest
# cuml + cuml-isolationforest
# pyod + pyod-isolationforest, pyod-copod, pyod-ecod, pyod-hbos,
# pyod-knn, pyod-lof, pyod-ocsvm, pyod-pca,
# pyod-autoencoder (CPU), pyod-autoencoder-gpu (CUDA GPU)
LH_ANOMALY_ALGORITHM=sklearn-isolationforest
# Single-detector mode only. Ensemble member devices are inferred per ID.
# Valid values: cpu, gpu
LH_ANOMALY_DEVICE=cpu

# PySpark Windows-specific
JAVA_HOME_WINDOWS="C:\\jdk-17"
HADOOP_HOME_WINDOWS="C:\\hadoop"

# PySpark Linux/Mac-specific
JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"

# Flags for file-based processing
LH_DATA_DIR = "data"
LH_DOCS_STORAGE_DIR_PATH = "data/docs/"
LH_LOG_DIR = "data/logs"
LH_FEATURE_DIR = "data/features/log_features"
LH_ANOMALY_DETECTION_DIR = "data/anomalies"
LH_MODEL_DIR = "data/models"






