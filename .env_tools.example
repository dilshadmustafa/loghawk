# Copy this file to .env_tools and set only the connectors you use.
# Optional explicit venv_tools Python executable path. Relative paths are resolved from the repo root.
LH_TOOLS_PYTHON=
# Prometheus base URL reachable from the LogHawk API process/container.
LH_TOOLS_PROMETHEUS_URL=
# Leave blank when the Prometheus endpoint does not require bearer authentication.
LH_TOOLS_PROMETHEUS_BEARER_TOKEN=
# Optional path to a mounted kubeconfig. Blank uses in-cluster credentials when available,
# otherwise the API process user's default kubeconfig.
LH_TOOLS_KUBERNETES_KUBECONFIG=
# Jira Cloud base URL, for example https://example.atlassian.net
LH_TOOLS_JIRA_BASE_URL=
LH_TOOLS_JIRA_EMAIL=
LH_TOOLS_JIRA_API_TOKEN=
